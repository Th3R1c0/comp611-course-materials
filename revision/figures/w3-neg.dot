// Negative edge breaks Dijkstra
digraph G {
  layout=neato; overlap=false; splines=true; pad=0.2; inputscale=1;
  node [shape=circle, style=filled, fillcolor="#ffffff", fontname="Helvetica", fontsize=15, width=0.5, fixedsize=true];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];
  edge [arrowsize=0.8];
  S [pos="0,62"];
  A [pos="144,124"];
  B [pos="144,0"];
  S -> A [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>2</TD></TR></TABLE>>];
  S -> B [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>4</TD></TR></TABLE>>];
  B -> A [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>−3</TD></TR></TABLE>>];
}
