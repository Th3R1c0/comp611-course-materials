// BFS lesson graph: undirected, weights used only for the BFS-vs-lightest example
graph G {
  layout=neato; overlap=false; splines=true; pad=0.2; inputscale=1;
  node [shape=circle, style=filled, fillcolor="#ffffff", fontname="Helvetica", fontsize=15, width=0.5, fixedsize=true];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];
  A [pos="0,62"];
  B [pos="129.6,124"];
  C [pos="129.6,0"];
  D [pos="259.2,124"];
  E [pos="259.2,0"];
  F [pos="388.8,62"];
  A -- B [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>4</TD></TR></TABLE>>];
  A -- C [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>1</TD></TR></TABLE>>];
  B -- D [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>4</TD></TR></TABLE>>];
  C -- D [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>1</TD></TR></TABLE>>];
  C -- E [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>2</TD></TR></TABLE>>];
  D -- F [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>4</TD></TR></TABLE>>];
  E -- F [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD>1</TD></TR></TABLE>>];
}
