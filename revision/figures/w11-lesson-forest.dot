// Week 11 lab Q5 forest, root 6 rank 3
digraph F {
  rankdir=BT; nodesep=0.4; ranksep=0.5; pad=0.2;
  node [shape=circle, style=filled, fillcolor="#ffffff", fontname="Helvetica", fontsize=15, width=0.5, fixedsize=true];
  edge [color="#555555", arrowsize=0.8];
  "1" [label="1"];
  "1" -> "2";
  "2" [label="2"];
  "2" -> "4";
  "3" [label="3"];
  "3" -> "4";
  "4" [label="4"];
  "4" -> "6";
  "5" [label="5"];
  "5" -> "6";
  "6" [label="6"];
  "7" [label="7"];
  "7" -> "6";
  "8" [label="8"];
  "8" -> "7";
  { rank=same; "6"; }
}