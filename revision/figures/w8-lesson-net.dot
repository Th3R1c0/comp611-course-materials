// Week 8 lab Q3 network, capacities
digraph G {
  layout=neato; overlap=false; splines=true; pad=0.25; inputscale=1;
  node [shape=circle, style=filled, fillcolor="#ffffff", fontname="Helvetica", fontsize=15, width=0.5, fixedsize=true];
  edge [fontname="Helvetica", fontsize=13, color="#555555", arrowsize=0.8];
  S [pos="0,70"];
  A [pos="144.0,140"];
  C [pos="144.0,0"];
  B [pos="288.0,140"];
  D [pos="288.0,0"];
  T [pos="432.0,70"];
  S -> A [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">5</FONT></TD></TR></TABLE>>];
  S -> C [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">8</FONT></TD></TR></TABLE>>];
  A -> B [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">1</FONT></TD></TR></TABLE>>];
  A -> D [taillabel=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">2</FONT></TD></TR></TABLE>>, labeldistance=3.2, labelangle=-28];
  C -> B [taillabel=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">3</FONT></TD></TR></TABLE>>, labeldistance=3.2, labelangle=28];
  C -> D [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">4</FONT></TD></TR></TABLE>>];
  B -> T [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">6</FONT></TD></TR></TABLE>>];
  D -> T [label=<<TABLE BORDER="0" BGCOLOR="white" CELLPADDING="1"><TR><TD><FONT COLOR="black">7</FONT></TD></TR></TABLE>>];
}
